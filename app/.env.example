# Mobile app environment variables
# Copy this file to .env and edit as needed

# Android Emulator (default — works out of the box with Android Studio)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Physical device on local Wi-Fi — replace with YOUR machine's LAN IP
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8000

# Production (when backend is deployed)
# EXPO_PUBLIC_API_BASE_URL=https://your-api-domain.com
