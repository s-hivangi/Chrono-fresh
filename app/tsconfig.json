{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      "expo-font": ["./types/expo-font.d.ts"],
      "expo-splash-screen": ["./types/expo-splash-screen.d.ts"],
      "expo-image-picker": ["./types/expo-image-picker.d.ts"],
      "expo-image-manipulator": ["./types/expo-image-manipulator.d.ts"],
      "expo-constants": ["./types/expo-constants.d.ts"],
      "expo-notifications": ["./types/expo-notifications.d.ts"],
      "react-native-reanimated": ["./types/react-native-reanimated.d.ts"],
      "expo-router/html": ["./types/expo-router-html.d.ts"],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
